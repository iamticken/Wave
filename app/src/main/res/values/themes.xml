<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Wave.DayNight.NoActionBar" parent="Theme.Wave.Light.NoActionBar" />

    <style name="Theme.Wave.Light.NoActionBar" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/wave_primary</item>
        <item name="colorPrimaryDark">@color/wave_primary_dark</item>
        <item name="colorAccent">@color/wave_accent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.Wave.Dark.NoActionBar" parent="@style/Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/wave_primary</item>
        <item name="colorPrimaryDark">@color/wave_primary_dark</item>
        <item name="colorAccent">@color/wave_accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Wave.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
